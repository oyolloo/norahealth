# ---- Database (Neon / PostgreSQL) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"

# ---- Auth ----
JWT_SECRET="your-jwt-secret"

# ---- Google Calendar (service account) ----
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Copy the value from the JSON key file's "private_key" field (keep the \n escapes)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Email (Resend) ----
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM="Nora Health <no-reply@example.com>"  # must be verified in Resend

# ---- App ----
APP_URL=https://example.com

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- Royal Mail Click & Drop API ----
# API key from Click & Drop account: Settings > Integrations > API
ROYAL_MAIL_CLICK_DROP_API_KEY=your-click-drop-api-key
# Sandbox: point at a test Click & Drop account key. Override base only if RM gives a different host.
ROYAL_MAIL_API_BASE=https://api.parcel.royalmail.com/api/v1
# Optional: RM service code (required for a trackable number), package format, weight
ROYAL_MAIL_SERVICE_CODE=
ROYAL_MAIL_PACKAGE_FORMAT=largeLetter
ROYAL_MAIL_WEIGHT_GRAMS=

# ---- Google Reviews (Places API New) ----
# Requires "Places API (New)" enabled on the key's Google Cloud project.
GOOGLE_PLACEID=your-place-id
GOOGLE_API_KEY=your-google-api-key

# SMS automations (CC-9). The Recallo24 API key can also be saved on /admin/automations.
RECALLO24_API_URL=https://recallo24.oyolloo.com/api/v1
RECALLO24_API_KEY=
# Shared secret for the hourly cron call to /api/cron/sms (header x-cron-secret).
CRON_SECRET=
